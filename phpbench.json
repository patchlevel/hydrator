{
  "$schema": "./vendor/phpbench/phpbench/phpbench.schema.json",
  "runner.bootstrap": "vendor/autoload.php",
  "runner.path": "tests/Benchmark",
  "runner.file_pattern": "*Bench.php",
  "runner.iterations": 5,
  "runner.php_config": {
    "memory_limit": "-1",
    "opcache.enable_cli": 1,
    "opcache.jit_buffer_size": 0,
    "xdebug.mode": "off"
  },
  "runner.assert": "mode(variant.time.avg) <= mode(baseline.time.avg) +/- 25%",
  "report.generators": {
    "diff": {
      "generator": "expression",
      "break": [
        "benchmark"
      ],
      "cols": [
        "subject",
        "revs",
        "its",
        "memory",
        "base",
        "current",
        "diff"
      ],
      "expressions": {
        "memory": "if(first(has_baseline), (first(result_mem_peak) as memory) ~ ' ' ~ percent_diff(first(baseline_mem_peak), first(result_mem_peak)), first(result_mem_peak) as memory)",
        "base": "if(first(has_baseline), mode(baseline_time_avg) as time ~ ' (' ~ rstdev(baseline_time_avg) ~ ')', '')",
        "current": "mode(result_time_avg) as time ~ ' (' ~ rstdev(result_time_avg) ~ ')'",
        "diff": "if(first(has_baseline), percent_diff(mode(baseline_time_avg), mode(result_time_avg), rstdev(result_time_avg)), '')"
      }
    }
  }
}
